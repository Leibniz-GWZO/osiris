DirectoryIndex index.php

# enable apache rewrite engine
RewriteEngine on

# set your rewrite base
RewriteBase /

# Deliver the folder or file directly if it exists on the server
RewriteRule ^(css|img|js|settings.json|manifest.json)($|/) - [L]

# Public images (portfolio, website) are delivered directly,
# all other uploads go through index.php with a permission check (see Uploads::PUBLIC_DIRS)
RewriteRule ^uploads/(topics|projects|groups)/ - [L]

# Push every request to index.php
RewriteRule ^(.*)$ index.php [QSA]
